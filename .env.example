# Supabase — copy to `.env.local` and fill in from your project's
# Settings → API page. Both are inlined into the client bundle at build time.
#
# The anon key is designed to be public: it identifies the project, and every
# row it can reach is gated by Row Level Security. NEVER put the service_role
# key here — it bypasses RLS entirely and would ship inside the APK.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
