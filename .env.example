# Supabase — copy to `.env.local` and fill in from your project's
# Settings → API page. Both values are inlined into the client bundle at build
# time, including the bundle packaged inside the Android APK.
#
# The key below is the PUBLIC one — labelled "Publishable key" in the current
# dashboard, "anon public" in older projects. It is designed to be published:
# every row it can reach is gated by Row Level Security.
#
# NEVER put the service_role / secret key here. It bypasses RLS entirely and
# would ship inside the APK for anyone to extract.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Set whichever name matches your dashboard — the app reads PUBLISHABLE_KEY
# first and falls back to ANON_KEY, so either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-legacy-anon-key
